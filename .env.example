# ==============================================================================
# PolicyLens AI - Production Environment Configuration Template
# Instructions: Copy this file to .env and replace placeholder values with your
# secure production secrets. NEVER commit the active .env file into Git!
# ==============================================================================

# --- Django Core Settings ---
DJANGO_SECRET_KEY=change-this-to-a-very-long-and-cryptographically-secure-random-secret-in-production
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend,frontend,0.0.0.0

# --- Security & Cookies ---
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True

# --- Cross-Origin Resource Sharing (CORS) ---
CORS_ALLOWED_ORIGINS=http://localhost,http://localhost:80,http://localhost:5173,http://127.0.0.1:5173

# --- PostgreSQL & pgvector Database ---
POSTGRES_DB=policylens_db
POSTGRES_USER=policylens_user
POSTGRES_PASSWORD=replace_with_a_secure_postgres_password_here
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# --- Redis & Celery Asynchronous Pipeline ---
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# --- Document Storage & Upload Restrictions ---
MAX_UPLOAD_SIZE_MB=25
COLLECT_STATIC=1

# --- AI Engine & LLM Configuration ---
# Options: mock, openai, anthropic, gemini, local
LLM_PROVIDER=mock
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
LOCAL_LLM_URL=http://localhost:11434

# Embedding Model Configuration
EMBEDDING_MODEL=text-embedding-3-small

