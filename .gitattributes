# Normalize line endings to LF for all text files
* text=auto eol=lf

# Force LF for shell scripts (must not be CRLF on Linux containers)
*.sh text eol=lf

# Windows-safe binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
